# ── Line-ending normalisation ──────────────────────────────────
* text=auto eol=lf

# ── Explicit text ──────────────────────────────────────────────
*.mjs      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.jsonl    text eol=lf
*.csv      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.sql      text eol=lf

# ── Explicit binary (no diff, no merge, no CRLF) ──────────────
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.avif     binary
*.ico      binary
*.svg      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.pdf      binary
*.duckdb   binary
*.duckdb.wal binary
*.db       binary
*.sqlite   binary
*.zip      binary
*.gz       binary
*.tar      binary
*.wasm     binary
