// FBI Vault Theme JavaScript

function set_warning_cookie() {
  const allcookies = document.cookie.split(';')
  for(let i = 0; i < allcookies.length; i++) {
    let cookie = allcookies[i].trim();
    // if the vault disclaimer has been shown, then no need to do anything
    if(cookie.indexOf("vaultdisclaimer") >= 0) {
      return false;
    }
  }

  document.cookie = "vaultdisclaimer=done;";
  return true;
}

function show_warning() {
  const show_disclaimer = set_warning_cookie();

  if(show_disclaimer) {
    const disclaimer_modal = new bootstrap.Modal(document.getElementById('foia-warning'));

    const url = window.location.protocol + "//" + window.location.host + "/foia-disclaimer-text";
    fetch(url)
      .then(response => {
        if(!response.ok) {
          throw new Error("could not fetch disclaimer, HTTP " + response.status);
        }
        return response.text();
      })
      .then(htmlstr => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlstr, "text/html");
        const title = doc.querySelector("#disclaimer-title");
        const content = doc.querySelector("#disclaimer-content");
        const el = document.querySelector("#foia-warning");
        if(title && content && el) {
          const eltitle = el.querySelector(".modal-title");
          eltitle.prepend(title);
          const elbody = el.querySelector(".modal-body");
          elbody.prepend(content);
          disclaimer_modal.show();
        }
        else {
          console.error("could not display disclaimer");
        }
      })
      .catch(error => {
        console.error("could not fetch disclaimer", error);
      });
  }
}


