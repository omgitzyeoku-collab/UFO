<br />
<button class="gradient-button" id="toggleOrientation" type="button" onclick="toggleChart()">Toggle Orientation</button></div>

<div id="chartAltTable">&nbsp;</div>
<script>
  let isHorizontal = true;

  const originalCategories = [
    'Above 60K*', '60K', '55K', '50K', '45K', '40K', '35K',
    '30K', '25K', '20K', '15K', '10K', '<5K'
  ];

  const originalCounts = [20, 40, 14, 65, 25, 60, 63, 93, 203, 287, 136, 81, 109];
  const totalAlt = originalCounts.reduce((sum, val) => sum + val, 0);
  const originalPercentages = originalCounts.map(count => +(count / totalAlt * 100).toFixed(1));

  let bchart;

  function labelEvery5(val, appendPercent = true) {
    const num = typeof val === 'number' ? val : Number(val);
    if (!isFinite(num)) return val;
    return num % 5 === 0 ? (appendPercent ? `${num}%` : `${num}`) : '';
  }

  function getChartOptions() {
    const reversed = !isHorizontal;

    const categories = reversed ? [...originalCategories].reverse() : [...originalCategories];
    const percentages = reversed ? [...originalPercentages].reverse() : [...originalPercentages];
    const counts = reversed ? [...originalCounts].reverse() : [...originalCounts];

    return {
      chart: {
        type: 'bar',
        height: 600,
        animations: {
          enabled: true,
          easing: 'easeinout',
          speed: 1000,
          animateGradually: { enabled: true, delay: 300 },
          dynamicAnimation: { enabled: true, speed: 1800 }
        }
      },
      colors: ['#001f3f'],
      plotOptions: {
        bar: {
          horizontal: isHorizontal,
          dataLabels: { position: 'center' }
        }
      },
      dataLabels: {
        enabled: true,
        formatter: (val) => `${val}%`,
        style: { colors: ['#fff'] }
      },
      series: [{
        name: 'Percentage',
        data: percentages
      }],
      xaxis: {
        categories: categories,
        max: 25,
        title: {
          text: isHorizontal ? 'Percentage of Sightings' : 'Altitude in Feet',
          style: { fontSize: '14px' }
        },
        labels: {
          formatter: (val) => isHorizontal ? labelEvery5(val, true) : val
        }
      },
      yaxis: {
        min: 0,
        max: 40,
        title: {
          text: isHorizontal ? 'Altitude in Feet' : 'Percentage of Sightings',
          style: { fontSize: '14px' }
        },
        labels: {
          style: {
            fontSize: '14px',
            cssClass: 'apexcharts-yaxis-label'
          },
          align: 'left',
          minWidth: 200,
          trim: false,
          formatter: (val) => isHorizontal ? val : labelEvery5(val, true)
        }
      },
      tooltip: {
        y: {
          formatter: function (val, { dataPointIndex }) {
            return `${val}% Sightings (${counts[dataPointIndex]})`;
          }
        }
      }
    };
  }

  function toggleChart() {
    isHorizontal = !isHorizontal;
    bchart.updateOptions(getChartOptions());
  }

  document.addEventListener("DOMContentLoaded", function () {
    bchart = new ApexCharts(document.querySelector("#bar-chart"), getChartOptions());
    bchart.render();
  });
  
  // Call the function
  createAccessibleTable(originalCategories, originalCounts, "chartAltTable", 
		"Reported UAP Altitudes");

</script>
