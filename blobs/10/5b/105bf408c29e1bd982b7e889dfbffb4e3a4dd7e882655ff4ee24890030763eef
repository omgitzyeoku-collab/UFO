.DashboardClear {
    clear: both;
}

.PhotoDashboardSettingsContainer {
    margin-top: 20px;
    margin-left: 30px;
}

.PhotoDashboardSettingsContainer label {
    font-size: 14px;
    vertical-align: middle;
}

.PhotoDashboardSettingsContainer input,
.PhotoDashboardSettingsContainer select {
    font-size: 14px;
    height: 32px;
    border-radius: 4px;
    border: 1px solid #999;
    padding: 2px 6px;
}

.PhotoDashboardSettingsContainer input[type=checkbox],
.PhotoDashboardSettingsContainer input[type=radio] {
    vertical-align: middle;
    margin-right: 4px;
}

.PhotoDashboardSettingsContainer .pdFormRowRemoveAction {
    color: red;
    font-size: 14px;
    margin-left: 20px;
    display: inline-block;
    border: none;
    background-color: transparent;
}

.zero-out-margins {
    margin: 0;
}
