var delta = 5;
var lastScrollTop = 0;
$(window).scroll(function(e) {
    let currentScrollTop = $(this).scrollTop();
    if (Math.abs(lastScrollTop - currentScrollTop) >= delta) {
        if (currentScrollTop > lastScrollTop) {
            // ACTION ON
            // SCROLLING DOWN 
            //$(".main-navbar-wrapper").css("opacity", "0");
            //$(".main-navbar-wrapper-top").css("opacity","0");
            if ($(this).scrollTop() >= 140) {
                $(".main-navbar-wrapper").css("transform", "translateY(-140px)");
            }
        } else {
            // ACTION ON
            // SCROLLING UP 
            //$(".main-navbar-wrapper").css("opacity", "1");
            //$(".main-navbar-wrapper-top").css("opacity","1");
            $(".main-navbar-wrapper").css("transform", "translateY(0px)");
            if (this.window.innerWidth > 991) {
                if (currentScrollTop > delta) {
                    $(".main-navbar-wrapper-bottom").css("height", "63px");
                    $(".main-navbar-menu li").css("height", "63px");
                    $(".main-navbar .nav-link").css("height", "63px").css("padding-top", "17px");
                    $(".navbar-underline").css("height", "63px").css("width", "53px");
                    $(".nav-search").css("height", "83px");
                    $(".nav-main-seal").hide();
                } else if (currentScrollTop <= delta) {
                    $(".main-navbar-wrapper-bottom").css("height", "100px");
                    $(".main-navbar-menu li").css("height", "99px");
                    $(".main-navbar .nav-link").css("height", "99px").css("padding-top", "36px");
                    $(".navbar-underline").css("height", "100px").css("width", "133px");
                    $(".nav-search").css("height", "102px");
                    $(".nav-main-seal").show();
                }
            }
        }
        lastScrollTop = currentScrollTop;
    }
});

function DisableScroll(toggle) {
    if (toggle) {
        // lock scroll position, but retain settings for later
        var scrollPosition = [
            self.pageXOffset || document.documentElement.scrollLeft || document.body.scrollLeft,
            self.pageYOffset || (document.documentElement.scrollTop) || (document.body.scrollTop)
        ];
        var html = jQuery('html'); // it would make more sense to apply this to body, but IE7 won't have that
        html.data('scroll-position', scrollPosition);
        html.data('previous-overflow', html.css('overflow'));
        html.css('overflow', 'hidden');
        window.scrollTo(scrollPosition[0], scrollPosition[1]);
    } else {
        // un-lock scroll position
        var html = jQuery('html');
        var scrollPosition = html.data('scroll-position');
        html.css('overflow', html.data('previous-overflow'));
        window.scrollTo(scrollPosition[0], scrollPosition[1])
    }
}
