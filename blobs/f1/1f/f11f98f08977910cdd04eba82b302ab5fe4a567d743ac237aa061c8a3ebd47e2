var openMenu = function() {

    if (!$(this).hasClass("is-active")) {
        $(this).addClass("is-active");
        $("#MenuOverlay").show();

        setTimeout(() => {
            $(".nav-menu-overlay").css("opacity", "1");
            $(".main-menu-list-item").css("opacity", "1");
        }, 5);

        //$("body").css("overflow", "hidden");
        $(".main-navbar-menu-icons .icon-ti-search").hide();

        _isMenuOpened = false;
    } else {
        $(this).removeClass("is-active");
        $("#MenuOverlay").css("opacity", "0").hide();
        $(".main-menu-list-item").css("opacity", "0");
        $("body").css("overflow", "auto");
        $(".main-navbar-menu-icons .icon-ti-search").show();

        _isMenuOpened = true;
    }
};

function GoTo(where) {
    //Do a check on the page var coming in
    where = where ? where.toLowerCase() : "";

    //Set a prefix home page for all redirects
    let prefix = "//www.cia.gov/";
    ////let prefix = "//" + window.location.host + "/";


    //Check if we clicked on the home
    let url = (where == "home") ? "" : where;

    //Finalize the url to be redirected
    window.location.href = prefix + url;

}

function GoToSocial(where) {
    var url = where ? where : "";

    switch (url) {
        case "twitter":
            url = "https://twitter.com/cia";
            break;
        case "facebook":
            url = "https://www.facebook.com/Central.Intelligence.Agency";
            break;
        case "youtube":
            url = "https://www.youtube.com/user/ciagov";
            break;
        case "instagram":
            url = "https://www.instagram.com/cia";
            break;
        case "flickr":
            url = "https://www.flickr.com/photos/ciagov";
            break;
        case "linkedin":
            url = "https://www.linkedin.com/company/central-intelligence-agency";
            break;
    }

    window.location.href = url;
}

