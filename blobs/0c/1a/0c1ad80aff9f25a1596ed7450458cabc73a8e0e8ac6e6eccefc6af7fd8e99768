/* ROW HOVER STYLES */
.record-row::before {
  content: "";
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.015),
    rgba(255, 255, 255, 0.015) 1px,
    transparent 2px,
    transparent 5px
  );
  opacity: 0.08;
  z-index: 1;
}


.record-row {
  position: relative;
  overflow: hidden;
}

.record-row::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    110deg,
    transparent 0%,
    rgba(180, 220, 220, 0.08) 45%,
    rgba(180, 220, 220, 0.18) 50%,
    rgba(180, 220, 220, 0.08) 55%,
    transparent 100%
  );
  transform: translateX(-100%);
  opacity: 0;
  z-index: 2;
}


.record-row:hover::after {
  animation: scanRowSoft 1s ease forwards;
  opacity: 1;
}


@keyframes scanRowSoft {
  from {
    transform: translateX(-120%);
  }
  to {
    transform: translateX(120%);
  }
}

