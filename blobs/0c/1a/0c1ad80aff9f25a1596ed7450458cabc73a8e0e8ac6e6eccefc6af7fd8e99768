 :root {
   --night: #02070d;
   --night-2: #050b13;
   --white: #d9d9d9;
   --muted: #A1A1A1;
   --panel: rgba(217, 217, 217, 0.12);
   --rule: rgba(217, 217, 217, 0.2);
   --rule-strong: rgba(166, 165, 168, 0.33);
   --ice: rgba(0, 255, 255, 0.5);
   --ice-dim: rgba(0, 255, 255, 0.24)
   --content: 1320px;
   --gutter: 60px;
 --mgutter: 30px;
   --mono: "Berkeley Mono Trial", "Berkeley Mono", "IBM Plex Mono", "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
 }


#aaro * {
   box-sizing: border-box;
 }
 html {
   background: var(--night);
   scroll-behavior: smooth;
 }
 #aaro {
   min-width: 320px;
   margin: 0;
   overflow-x: hidden;
   background: radial-gradient(circle at 50% 9%, rgba(133, 188, 255, 0.055), transparent 24rem), linear-gradient(180deg, rgba(5, 11, 19, 0.86), var(--night) 19rem, var(--night) 100%);
   color: var(--white);
   font-family: var(--mono);
   font-size: 14px;
   line-height: 1.38;
   letter-spacing: 0;
   text-transform: uppercase;
 }
 body::before {
   position: fixed;
   inset: 0;
   z-index: 50;
   pointer-events: none;
   content: "";
 }
 body::before {
   opacity: 0.17;
   background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.055) 0 1px, transparent 1px 5px), repeating-linear-gradient(90deg, rgba(133, 188, 255, 0.025) 0 1px, transparent 1px 22px);
   mix-blend-mode: screen;
 }
 #aaro a {
   color: inherit;
   text-decoration: none;
 }
 #aaro button {
   padding: 0;
   border: 0;
   background: transparent;
   color: inherit;
   font: inherit;
   text-align: left;
   text-transform: inherit;
   cursor: pointer;
 }
 #aaro img {
   display: block;
   max-width: 100%;
 }
 #aaro {
   position: relative;
   width: 100%;
   min-height: 4047px;
   padding: 135px var(--gutter) 56px;
   isolation: isolate;
 }
 #aaro::before {
   position: fixed;
   inset: 0 auto 0 0;
   width: 13.5vw;
   min-width: 96px;
   max-width: 205px;
   pointer-events: none;
   content: "";
   background: linear-gradient(90deg, var(--night), rgba(2, 7, 13, 0));
   opacity: 0.9;
   z-index: 6;
 }
 #aaro::after {
   position: fixed;
   inset: 0 0 0 auto;
   width: 13.5vw;
   min-width: 96px;
   max-width: 205px;
   pointer-events: none;
   content: "";
   background: linear-gradient(270deg, var(--night), rgba(2, 7, 13, 0));
   opacity: 0.9;
   z-index: 6;
 }
.reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition:
        opacity 900ms ease,
        transform 900ms ease;
}

.reveal-up.in-view {
    opacity: 1;
    transform: translateY(0);
}
#aaro .masthead {
    position: relative;
    z-index: 10;
    grid-template-areas: "brand descriptor nav-left nav-right . meta";
    align-items: start;
    width: 100%;
    max-width: none;
    margin: 0;
    color: var(--muted);
    text-shadow: 0 0 6px rgba(133, 188, 255, 0.2);
    display: grid;
    grid-template-columns: 0 346px 106px minmax(0, 1fr) 170px;
    gap: 38px;
}
 #aaro .brand {
   grid-area: brand;
   color: var(--white);
 }
 #aaro .descriptor {
   grid-area: descriptor;
   max-width: 300px;
   min-width: 0;
   line-height: 1.65;
   overflow-wrap: anywhere;
 }
 #aaro .descriptor-mobile {
   display: none;
 }
 #aaro .mobile-nav {
   display: none;
 }
 #aaro .nav-stack {
   display: grid;
   gap: 2px;
 }
 #aaro .nav-stack-primary {
   grid-area: nav-left;
 }
 #aaro .nav-stack-secondary {
   grid-area: nav-right;
 }
 #aaro .meta-stack {
   display: grid;
   gap: 2px;
 }
 #aaro .masthead .meta-stack {
   grid-area: meta;
 }
 #aaro .nav-link {
   color: var(--muted);
   transition: color 180ms ease, text-shadow 180ms ease, transform 180ms ease;
 }
 #aaro .nav-link:hover, #aaro .nav-link:focus-visible {
   color: var(--white);
   outline: 0;
   text-shadow: 0 0 12px var(--ice-dim);
   transform: translateX(3px);
 }
 #aaro .active-link {
   color: var(--white);
 }
 #aaro .active-link::before {
   color: var(--ice);
   content: ">";
 }
 #aaro.button.arrow::before, #aaro .row-arrow::before {
   color: var(--ice);
   content: "> ";
 }
 #aaro .meta-stack {
   justify-items: end;
   text-align: right;
 }
 #aaro .hero {
   position: relative;
   max-width: 1450px;
   height: 430px;
   margin: 119px auto 0;
   overflow: hidden;
  
 }
 #aaro .hero::before, #aaro .hero::after {
   position: absolute;
   top: 70px;
   z-index: 5;
   width: 205px;
   height: 221px;
   content: "";
 }
 #aaro .hero::before {
   left: 0;
   background: linear-gradient(90deg, var(--night), rgba(2, 7, 13, 0));
 }
 #aaro .hero::after {
   right: 0;
   background: linear-gradient(270deg, var(--night), rgba(2, 7, 13, 0));
 }
 #aaro .evidence-field {
   position: absolute;
   inset: 0;
   overflow: hidden;
 }
 #aaro .thumb {
   position: absolute;
   z-index: 1;
   overflow: hidden;
   background: #0a0f14;
   outline: 1px solid rgba(217, 217, 217, 0.08);
   opacity: 0.32;
   filter: saturate(0) contrast(1.25) brightness(0.72);
   mix-blend-mode: luminosity;
   transition: opacity 180ms ease, filter 180ms ease, outline-color 180ms ease, box-shadow 180ms ease, scale 180ms ease, translate 180ms ease;
 }
 #aaro .thumb img {
   width: 100%;
   height: 100%;
   object-fit: cover;
   transform: scale(1.22);
 }
 #aaro .thumb:hover, #aaro .thumb:focus-visible, #aaro .thumb.is-active {
   z-index: 6;
   opacity: 0.66;
   outline-color: rgba(133, 188, 255, 0.44);
   filter: saturate(0.1) contrast(1.32) brightness(0.94);
   box-shadow: 0 0 0 1px rgba(133, 188, 255, 0.2), 0 0 24px rgba(133, 188, 255, 0.2);
   scale: 1.04;
   translate: 0 -7px;
 }
 #aaro .thumb:focus-visible {
   outline: 1px solid var(--ice);
   outline-offset: 4px;
 }
