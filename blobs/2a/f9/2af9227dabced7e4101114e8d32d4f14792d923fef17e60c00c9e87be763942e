/**
* Breadcrumb overrides
*/
ul.breadcrumbs {
  padding-bottom: 0px;
}

/**
* search box alterations */

div.region.region-search-bar {
  margin-bottom:20px;
}

#edit-field-collection-wrapper {
  display: none;
}

.views-exposed-form .views-exposed-widget {
  float: left;
  padding: .5em 1em 0 0;
}

div.search-submit {
  float: left;
}

div.search-reset {
  float: right;
  margin-left: 8px;
}

div.search-reset a {
  vertical-align: middle;
  border: 1px #8CACBB solid;
  color: black!important;
  display: inline-block;
  margin-top: 14px;
  font-size: 11px;
  text-decoration: none;
  padding: 2px 4px 3px 4px;
}

.views-exposed-form .views-exposed-widget .form-submit {
  margin-top: 16px;
  height: 25px;
}

.views-exposed-form .form-item, .views-exposed-form .form-submit {
  margin-top: 0;
  margin-bottom: 0;
}

input {
  visibility: visible;
  border: 1px solid #8cacbb;
  color: Black;
  vertical-align: middle;
}

input#edit-submit-button {
    height: 25px;
}

input#edit-search-block-form--2 {
    width: 200%;
}

/**
* Remove title in menu section
*/
div#block-menu-menu-library h2.title {
  display: none;
}

.sidebar-nav div.content > ul > li:first-child a {
  color: #666;
  font-weight: bold;
}

div#block-menu-menu-library ul.menu ul li.active-trail {
  background: url(../images/new/ico-08.gif) no-repeat;
  padding: 0 0 11px 19px;
  margin: 0 0 0 -5px;
  color: #35486a;
  text-decoration: none;
  line-height: 15px;
}

div#block-menu-menu-library ul.menu ul li.active-trail.no-mark {
  background: none;
  font-weight:bold;
  padding-left: 12px;
  margin: 0;
  padding: 0;
}

div#block-menu-menu-library ul.menu > li.expanded {
  background: url(../images/new/ico-08.gif) no-repeat;
  padding: 0 0 11px 19px;
  margin: 0 0 0 -5px;
  font-weight: bold;
}

div#block-menu-menu-library ul.menu > li.expanded.no-mark {
  background: none;

}

.sidebar-nav ul ul li a {
}

.sidebar-nav ul ul li .active-trail {
  text-decoration: none;
  font-weight: bold;
}

ul li.leaf,
ul li.collapsed,
ul li.expanded {
  list-style-image: none;
  list-style-type: none;
  font-size: .95em;
  line-height: 1.125em;
  font-weight: normal;
}

.sidebar-nav ul li.leaf,
.sidebar-nav ul li.collapsed,
.sidebar-nav ul li.expanded {
  margin: 0;
  vertical-align: top;
  padding: 0 0 10px;
}

nav.sidebar-nav  div.content > ul.menu > li {
  padding: 0 0 11px 15px;
  margin: 0;
}

/**
* Document list fixes
*/
#block-views-documents-docs-in-collection h4.field-content,
#block-views-documents-docs-in-collection p.docType {
  margin-bottom: 0;
  margin-top: 0;
}

#block-views-documents-docs-in-collection .views-row,
.view-documents.view-display-id-page_1 .views-row,
.view-documents.view-display-id-page_2 .views-row {
  margin-bottom: 15px;
}

.view-search-results .views-field-field-page-count,
.view-search-results .views-field-field-original-classification,
.view-search-results .views-field-field-creation-date,
.view-search-results .views-field-field-release-date,
#block-views-documents-docs-in-collection .views-field-field-page-count,
#block-views-documents-docs-in-collection .views-field-field-original-classification {
  float: left;
  margin-right: 15px;
}

#block-views-documents-docs-in-collection div.views-field-field-page-count span,
#block-views-documents-docs-in-collection div.views-field-field-page-count div.field-content {
  display: inline;
}

.view-search-results .views-field-field-file, #block-views-documents-docs-in-collection .views-field-field-file {
  padding-top: 3px;
  padding-bottom: 3px;
  clear: both;
}

a span.document_download {
  height: 1px;
  width: 1px;
  position: absolute;
  overflow: hidden;
  top: -10px;
}

img.file-icon {
  vertical-align: middle;
  line-height: normal;
  margin-top: -1px;
}

/**
* Search results fixes
*/
.view-search-results .views-field-title, #block-views-documents-docs-in-collection .views-field-title {
  font-size: 125%;
  font-weight: bold;
}

.view-search-results .views-label {
  font-weight: bold;
}

.view-search-results .views-field-field-file a {
  margin-left: 5px;
}

.view-search-results .views-row, #block-views-documents-docs-in-collection .views-row {
  padding-top: 10px;
  padding-bottom: 10px;
}
  
.view-search-results {
  width: 500px;
  float: left;
}
/**
 * * Search Facet overrides
 * */
#sidebar-second {
  margin-left: 10px;
  margin-bottom: 10px;
  border-left: 1px solid #000;
  padding-left: 10px;
  float: right;
  width: 180px;
}

/**
* Footer overrides
*/
div.footer-panel {
  text-align: center;
  margin-bottom: 0;
}
div.footer-panel div#block-menu-menu-footer h2.title {
  display: none;
}
div.footer-panel ul li {
  margin: 0;
}
div.footer-panel ul li a {
  font-size: 13px;
  line-height: 17px;
}
a.footer-logo {
  float: none;
}

div.description {
  font-family:"PT Sans", "HelveticaNeue", "Helvetica Neue", Helvetica, Arial, sans-serif;
  background:#707070;
  text-align:left;
  display:none;
  border-radius:5px 5px 5px 5px;
  color:#ffffff;
  font-size:0.75em;
  line-height:150%;
  padding:5px 10px;
  position:absolute;
  max-width:250px;
  margin:0 50px 0 0;
  text-shadow:1px 1px #555555;
}

div.description:after {
  border-color:#707070 transparent;
  border-style:solid;
  border-width:8px 8px 0;
  bottom:-8px;
  content:"";
  display:block;
  left:10px;
  position:absolute;
  width:0;
}

div.description:before {
  border-color:#707070 transparent;
  border-width:17px 17px 0;
  bottom:-15px;
  content:"";
  display:block;
  left:43px;
  position:absolute;
  width:0;
}

