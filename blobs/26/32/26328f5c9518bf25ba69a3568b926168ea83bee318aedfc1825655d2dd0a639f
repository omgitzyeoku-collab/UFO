<script type="text/javascript">
    var allPlayers = [];
    jQuery(document).ready(function () {
        var moduleContainer = jQuery("#dnn_ctr57294_ModuleContent");
        var slideWrapper = moduleContainer.find(".slideWrapper");
        var slideContainer = moduleContainer.find(".slideContainer");
        //var pagerContainer = moduleContainer.find(".pagerContainer");
        var slides = slideContainer.children("div.GenericSlideshowItem");
        var windowResizeTimeout = null;
        var windowResizeTimeoutInterval = 100;
        var slider;
        var counterUsed = false;
        var blankBullets = 0;
        var blankBulletsPerslide = 0;

        //Right arrow fix
        jQuery(moduleContainer).parents(".DnnModule-SlideShow").css("position", "static");

        var fakeSlides = false;
        if (slides.length < 3 && slides.length != 1) {
            slides.each(function () {
                jQuery(this).clone().appendTo(slideContainer);
            });
            fakeSlides = true;
            slides = slideContainer.children("div.GenericSlideshowItem");
        }

        jQuery(slideContainer).royalSlider({
            arrowsNav: true,
            addActiveClass: true,
            loop: true,
            keyboardNavEnabled: true,
            controlsInside: false,
            imageScaleMode: '',
            arrowsNavAutoHide: false,
            controlNavigation: 'bullets',
            navigateByClick: true,
            startSlideId: 0,
            autoPlay: {
                enabled: true,
                stopAtAction: true,
                pauseOnHover: true,
                delay: 5000
            },
            sliderTouch: true
        });

        //set up the height right after init and again after content has loaded
        SetSlideshowHeight();
        slider = jQuery(slideContainer).data('royalSlider');
        slider.ev.on('rsAfterContentSet', function(e, slideObject) {
            SetSlideshowHeight();
        });

        function updateBeforeSlideAnimation() {
            $('.rsNavItem').removeClass('rsNavPrev rsNavNext');
            const navItems = $('.rsNavItem');
            // apply class to prev bullet
            if (slider.currSlideId > 0) {
                navItems.eq(slider.currSlideId - 1).addClass('rsNavPrev');
            }
            else {
                navItems.eq(slider.numSlides - 1).addClass('rsNavPrev');
            }
            // apply class to next bullet
            if (slider.currSlideId < (slider.numSlides - 1)) {
                navItems.eq(slider.currSlideId + 1).addClass('rsNavNext');
            }
            else {
                navItems.eq(0).addClass('rsNavNext');
            }
        }
        
        updateBeforeSlideAnimation();
        
        slider.ev.on('rsBeforeAnimStart', function (event) {
            // triggers after current slide is updated, but before rsNavSelected is set change
            updateBeforeSlideAnimation();
        });

        //prevent visibility while slideshow is not initialized
        slideWrapper.fadeOut(0).css({ 'visibility': 'visible' }).fadeIn(400);

        jQuery(slides).each(function () {
            var cssClass = this.classList[1];
            var blah = jQuery(this).parent(".rsSlide");
            blah.addClass(cssClass);
            jQuery(this).removeClass(cssClass);
        });

        if (fakeSlides) {
            slider.ev.on('rsAfterSlideChange', function (event) {
                const navitems = jQuery('.rsNavItem');
                navitems.removeClass('rsNavSelected rsNavNext rsNavPrev');

                if (event.target.currSlideId == 0 || event.target.currSlideId == 2) {
                    // slider.goTo(0); <<-- causes slide warp, only purpose is to highlight correct spoofed nav items
                    navitems.eq(0).addClass('rsNavSelected');
                    navitems.eq(1).addClass('rsNavNext rsNavPrev');
