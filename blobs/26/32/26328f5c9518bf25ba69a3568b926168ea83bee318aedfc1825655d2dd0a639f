                else if (event.target.currSlideId == 1 || event.target.currSlideId == 3) {
                    // slider.goTo(1); <<--- see above
                    const navitems = jQuery('.rsNavItem');
                    navitems.eq(1).addClass('rsNavSelected');
                    navitems.eq(0).addClass('rsNavNext rsNavPrev');
                }
            });
        }

        var pageArrows = slideContainer.children("div.rsArrow");
